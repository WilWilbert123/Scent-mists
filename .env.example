# ==============================================================================
# SCENTS & MISTS — Environment Variables Configuration
# Copy this file to .env.local and provide your real Supabase credentials.
# Never commit .env.local to version control.
# ==============================================================================

# Public Supabase project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anonymous key (safe for browser use with Row Level Security enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase Service Role key (NEVER expose to client code or prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL used for Open Graph, canonical links, sitemap, and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional webhook signing secret for /api/webhooks
WEBHOOK_SECRET=

